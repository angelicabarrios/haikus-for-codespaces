<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Entre Cenizas y Carne</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Creepster&family=Roboto&display=swap');

    /* Reset básico */
    * {
      box-sizing: border-box;
    }
    body {
      margin: 0;
      font-family: 'Roboto', sans-serif;
      background: black url('https://www.transparenttextures.com/patterns/dark-mosaic.png');
      color: white;
      line-height: 1.5;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    header {
      background: rgba(20, 0, 0, 0.85);
      padding: 2rem 1rem;
      text-align: center;
      font-family: 'Creepster', cursive;
      font-size: 3rem;
      color: crimson;
      letter-spacing: 3px;
      user-select: none;
    }
    nav {
      background: #111;
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      padding: 0.5rem;
    }
    nav a {
      color: white;
      text-decoration: none;
      padding: 0.7rem 1.5rem;
      background: #330000;
      border-radius: 5px;
      font-weight: 700;
      transition: background-color 0.3s ease;
      user-select: none;
    }
    nav a:hover,
    nav a:focus {
      background: crimson;
      outline: none;
    }

    main {
      flex: 1;
      max-width: 900px;
      margin: 2rem auto 4rem;
      padding: 0 1rem;
    }

    section {
      margin-bottom: 3rem;
    }

    h2 {
      color: crimson;
      font-family: 'Creepster', cursive;
      font-size: 2.5rem;
      margin-bottom: 1rem;
      border-bottom: 2px solid crimson;
      padding-bottom: 0.3rem;
      user-select: none;
    }

    p {
      font-size: 1.1rem;
    }

    /* Botones principales */
    button, .btn-link {
      cursor: pointer;
      background: crimson;
      color: white;
      border: none;
      padding: 0.7rem 1.4rem;
      margin-top: 0.8rem;
      font-weight: 700;
      border-radius: 5px;
      transition: background-color 0.3s ease;
      user-select: none;
      display: inline-block;
      text-align: center;
      text-decoration: none;
    }
    button:hover, button:focus,
    .btn-link:hover, .btn-link:focus {
      background: #aa0000;
      outline: none;
    }

    /* Galería de personajes */
    .gallery {
      display: flex;
      flex-wrap: wrap;
      gap: 15px;
      justify-content: center;
    }
    .gallery-item {
      background: #220000;
      border-radius: 8px;
      overflow: hidden;
      max-width: 200px;
      text-align: center;
      box-shadow: 0 0 10px crimson;
      user-select: none;
    }
    .gallery-item img {
      width: 100%;
      display: block;
      height: auto;
    }
    .gallery-item figcaption {
      padding: 0.5rem 0;
      font-weight: 600;
      color: #f44343;
    }

    /* Sección virus Lethe-9 */
    .virus-list {
      background: #1a0000;
      padding: 1rem;
      border-radius: 8px;
      box-shadow: 0 0 10px #550000;
    }
    .virus-list h3 {
      color: #ff6666;
      margin-top: 0;
    }
    .virus-item {
      margin-bottom: 1rem;
      padding-bottom: 0.6rem;
      border-bottom: 1px solid #550000;
    }
    .virus-item:last-child {
      border-bottom: none;
    }
    .virus-item strong {
      color: crimson;
      user-select: text;
    }

    /* Comentarios lectores */
    .comments {
      background: #110000;
      padding: 1rem;
      border-radius: 8px;
      box-shadow: 0 0 8px #440000;
    }
    .comment {
      margin-bottom: 1rem;
      border-bottom: 1px solid #440000;
      padding-bottom: 0.7rem;
    }
    .comment:last-child {
      border-bottom: none;
    }
    .comment strong {
      color: crimson;
    }
    .comment em {
      font-size: 0.9rem;
      color: #bb4444;
    }

    /* Test interactivo */
    .quiz {
      background: #1b0000;
      border-radius: 8px;
      padding: 1rem 1.5rem;
      box-shadow: 0 0 12px crimson;
      max-width: 700px;
      margin: 0 auto;
      user-select: none;
    }
    .quiz-question {
      font-size: 1.3rem;
      margin-bottom: 1rem;
      color: #ff5555;
    }
    .quiz-options {
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
      margin-bottom: 1rem;
    }
    .quiz-options button {
      background: #440000;
      padding: 0.8rem 1rem;
      border-radius: 6px;
      font-weight: 600;
      color: #ffaaaa;
      border: 2px solid transparent;
      text-align: left;
      transition: background-color 0.25s ease, border-color 0.25s ease;
    }
    .quiz-options button:hover,
    .quiz-options button:focus {
      background: #aa0000;
      border-color: crimson;
      color: white;
      outline: none;
    }
    .quiz-result {
      font-size: 1.4rem;
      font-weight: 700;
      color: crimson;
      text-align: center;
      margin-top: 1rem;
      min-height: 4rem;
      user-select: text;
    }
    .quiz-buttons {
      display: flex;
      justify-content: center;
      gap: 1rem;
      margin-top: 1rem;
      flex-wrap: wrap;
    }

    /* Responsive */
    @media (max-width: 600px) {
      nav {
        flex-direction: column;
        gap: 8px;
      }
      .gallery {
        justify-content: center;
      }
    }
  </style>
</head>
